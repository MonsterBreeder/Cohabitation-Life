{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "家里有事",
				"navigationBarBackgroundColor": "#FFF9F2",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "家里有事"
			}
		},
		{
			"path": "pages/create-home/index",
			"style": {
				"navigationBarTitleText": "创建我们的家"
			}
		},
		{
			"path": "pages/join-home/index",
			"style": {
				"navigationBarTitleText": "加入我们的家"
			}
		},
		{
			"path": "pages/invite-status/index",
			"style": {
				"navigationBarTitleText": "邀请状态"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "家里有事",
		"navigationBarBackgroundColor": "#FFF9F2",
		"backgroundColor": "#FFF9F2"
	}
}
